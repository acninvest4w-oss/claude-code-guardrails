{
  "permissions": {
    "deny": [
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/guardrails.json)",
      "Edit(/vendor/**)",
      "Edit(//c/tools/claude-code-guardrails/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "C:/path/to/pythonw.exe C:/tools/claude-code-guardrails/hooks/hide.py node C:/tools/claude-code-guardrails/hooks/guard.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "C:/path/to/pythonw.exe C:/tools/claude-code-guardrails/hooks/hide.py node C:/tools/claude-code-guardrails/hooks/guard.js"
          }
        ]
      }
    ]
  }
}
